{
  "name": "sqlite-js-stream",
  "version": "0.1.0",
  "description": "Node.js port of Litestream: SQLite streaming replication & disaster recovery via LTX files",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "license": "Apache-2.0",
  "author": "Matteo Collina",
  "homepage": "https://github.com/platformatic/sqlite-js-stream",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/sqlite-js-stream.git"
  },
  "bugs": {
    "url": "https://github.com/platformatic/sqlite-js-stream/issues"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:all": "pnpm test && pnpm -r test",
    "typecheck:all": "pnpm typecheck",
    "bench": "node bench/bench-sync-restore.ts"
  },
  "dependencies": {
    "lz4js": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "neostandard": "^0.13.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "sqlite",
    "litestream",
    "replication",
    "backup",
    "ltx",
    "disaster-recovery"
  ]
}
